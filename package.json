{
  "name": "desk-pet",
  "version": "0.6.6",
  "description": "Windows 桌面宠物：自定义角色形象、点击看天气/喝水提醒，名称大小模式位置全部可配置",
  "main": "app/main.js",
  "private": true,
  "author": {
    "name": "liuhaolh6",
    "url": "https://github.com/liuhaolh6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhaolh6/desk-pet.git"
  },
  "homepage": "https://github.com/liuhaolh6/desk-pet#readme",
  "bugs": {
    "url": "https://github.com/liuhaolh6/desk-pet/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "test": "node tools/smoke.js",
    "check": "node --check app/main.js && node --check app/window-state.js && node --check app/main/log.js && node --check app/main/geometry.js && node --check app/main/window-layout.js && node --check app/main/tray.js && node --check app/main/diagnostics.js && node --check app/preload.js && node --check app/cutout.js && node --check app/pet.js && node --check app/settings.js && node --check app/onboard.js && node --check lib/cutout.js && node --check lib/cutout-worker.js && node --check lib/cutout-pixels.js && node --check lib/cutout-math.js && node --check lib/png.js && node --check lib/store.js && node --check tools/cutout-diag.js && node --check tools/smoke.js && node --check tools/make-cutout-fixtures.js",
    "diag:fixtures": "node tools/cutout-diag.js --fake tools/fixtures/synthetic-portrait.png --mask tools/fixtures/synthetic-portrait-mask.png --assert",
    "dist": "electron-builder --win portable",
    "dist:dir": "electron-builder --win dir --x64",
    "verify:signature": "powershell -NoProfile -ExecutionPolicy Bypass -File tools\\verify-signature.ps1",
    "shortcut": "powershell -ExecutionPolicy Bypass -File tools\\make-shortcut.ps1"
  },
  "keywords": [
    "desktop-pet",
    "electron",
    "weather",
    "windows",
    "u2net",
    "photo-cutout",
    "desktop-widget"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.deskpet.app",
    "productName": "DeskPet",
    "copyright": "Copyright © 2026 liuhaolh6",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "lib/**/*",
      "assets/**/*",
      "!assets/models/**",
      "!assets/source/**",
      "!node_modules/onnxruntime-node/bin/napi-v3/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v3/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v3/win32/arm64/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/onnxruntime-common/**",
      "lib/**"
    ],
    "asar": true,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "toolsets": {
      "nsis": "1.2.1"
    },
    "win": {
      "icon": "build/icon.ico",
      "executableName": "DeskPet",
      "artifactName": "DeskPet-${version}-portable.${ext}",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "DeskPet-${version}-portable.${ext}",
      "requestExecutionLevel": "user"
    }
  },
  "dependencies": {
    "onnxruntime-node": "^1.20.1"
  }
}
